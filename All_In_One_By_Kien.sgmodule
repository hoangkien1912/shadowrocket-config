#!name=Kien - Core 4 Apps - 2026-10-26
#!desc=YouTube, Locket, Spotify, SoundCloud. Script URLs checked; app behavior still requires device testing.
# Sources: Maasea/sgmodule; vuong2023/shad (Ohoang7); app2smile/rules; Marol62926/MarScrpt.
# Use as a module. Disable other modules handling these same apps.
# Do not enable together with All_In_One_Locket_Updated.sgmodule.
# No proxy credentials, CA certificate, subscription node or cron task is included.

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Script]
# YouTube: request and response use DIFFERENT upstream files.
# Upstream: https://raw.githubusercontent.com/Maasea/sgmodule/master/YouTube.Enhance.sgmodule
# Concrete arguments replace upstream Surge template placeholders.
# Keep Shorts and upload UI; subtitle translation off during initial testing.
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{"captionLang":"off"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js

# Locket: preserve the pair from the module the user reports working.
# Upstream script also modifies other RevenueCat responses; do not stack RevenueCat modules.
locket.response = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/vuong2023/shad/main/js/Locket_Ohoang7.js,requires-body=true,max-size=-1,timeout=60
locket.deleteHeader = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/vuong2023/shad/main/js/deleteHeader.js,timeout=60

# Spotify: original app2smile module, partial client-side features only.
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-proto.js,script-update-interval=0

# SoundCloud: source reachable; old script. Server-side Go+ catalog/offline rights not verified.
soundcloud.response = type=http-response,pattern=^https:\/\/api-mobile\.soundcloud\.com\/configuration\/ios(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Marol62926/MarScrpt/main/soundcloud.js

# PicsArt: this source requires RESPONSE, not the old REQUEST rule.
# Match the API documented inside NobyDa's script, not guessed gw-v2 endpoints.
picsart.response = type=http-response,pattern=^https:\/\/api\.(picsart|meiease)\.c(n|om)\/shop\/subscription\/(validate|apple\/purchases),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Surge/JS/PicsArt.js

# CamScanner: upstream documents only partial features.
camscanner.response = type=http-response,pattern=^https:\/\/(api|api-cs)\.intsig\.net\/purchase\/cs\/query_property\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Surge/JS/CamScanner.js

# Wink: limit to the user VIP-info endpoint; do not rewrite every Meitu response.
wink.response = type=http-response,pattern=^https:\/\/api-sub\.meitu\.com\/v2\/user\/vip_info(?:_by_group)?\.json(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ekaznyra/NguyenNgocAnhTu/master/Module/js/Wink.js

# Truecaller: exactly the two endpoint types handled by this source.
truecaller.response = type=http-response,pattern=^https:\/\/premium-[^.]+\.truecaller\.com\/v\d+\/(subscriptions\/status|products\/apple)(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ekaznyra/NguyenNgocAnhTu/master/Module/js/TrueCaller.js

# KineMaster: legacy assetstore API. Do not reuse api-account /user/subscribe.
kinemaster.response = type=http-response,pattern=^https:\/\/api-kinemaster-assetstore\.(nexstreaming|kinemasters)\.com\/.+\/product\/verifyReceipt$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NobyDa/Scripting/master/kinemaster.js

# BeautyPlus: only manual_unlock. The script's asset/balance branch is intentionally not matched.
beautyplus.response = type=http-response,pattern=^https:\/\/api\.mr\.pixocial\.com\/v1\/manual_unlock(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ekaznyra/NguyenNgocAnhTu/master/Module/js/BeautyPlus.js

# Lightroom: existing source; does not grant genuine Adobe cloud storage.
lightroom.response = type=http-response,pattern=^https:\/\/photos\.adobe\.io\/v2\/accounts(?:[/?].*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/litieyin/AD_VIP/main/Script/lightroom.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, api.revenuecat.com, spclient.wg.spotify.com, *spclient.spotify.com, api-mobile.soundcloud.com, api.picsart.com, api.picsart.cn, api.meiease.com, api.meiease.cn, api.intsig.net, api-cs.intsig.net, api-sub.meitu.com, premium*.truecaller.com, api-kinemaster-assetstore.nexstreaming.com, api-kinemaster-assetstore.kinemasters.com, api.mr.pixocial.com, photos.adobe.io

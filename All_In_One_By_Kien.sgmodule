#!name=Kien - All In One Merged - 2026-10-26
#!desc=Core apps + iSteal-it extra apps + hostsVN ad-block rules. Duplicates and conflicting scripts removed. Script URLs of the new apps are NOT verified; test on device.
# Sources: Maasea/sgmodule; vuong2023/shad (Ohoang7); app2smile/rules; Marol62926/MarScrpt; NobyDa; ekaznyra; litieyin;
#          iSteal-it/script; duyvinh09/Module_IOS; N9dev-dev/SL; bigdargon/hostsVN.
# Use as a module. Disable other modules handling these same apps.
# Do not enable together with All_In_One_Locket_Updated.sgmodule or any other RevenueCat module.
# Do not ALSO import hostsVN-shadowrocket.conf as a config: its rules are already included below.
# No proxy credentials, CA certificate, subscription node or cron task is included.
# (hostsVN's public ca-p12 and the Sub-Store cron/scripts were intentionally left out.)

[Rule]
# Force YouTube off QUIC so the TCP/MITM scripts can run (from iSteal-it config).
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
# hostsVN (Vietnam ad/tracker blocking). Exceptions first, then reject lists.
RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/option/hostsVN-surge-exceptions-rule.conf,DIRECT
RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/option/hostsVN-surge-rule.conf,REJECT
RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/option/hostsVN-surge-rewrite.conf,REJECT
RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/extensions/threat/surge-rule.conf,REJECT
#RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/option/hostsVN-surge-OTA.conf,REJECT
#RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/option/hostsVN-surge-FB.conf,REJECT
#RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/extensions/adult/surge-rule.conf,REJECT
#RULE-SET,https://raw.githubusercontent.com/bigdargon/hostsVN/master/extensions/gambling/surge-rule.conf,REJECT
IP-CIDR,0.0.0.0/32,REJECT,no-resolve

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[URL Rewrite]
# YouTube ad blocking (from iSteal-it config, same set as Maasea's YouTube module).
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200
# ctier stripping: ONE rule only. hostsVN's simpler ctier rule was dropped because it would fight with this one.
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[Script]
# YouTube: request and response use DIFFERENT upstream files.
# Upstream: https://raw.githubusercontent.com/Maasea/sgmodule/master/YouTube.Enhance.sgmodule
# Concrete arguments replace upstream Surge template placeholders.
# Keep Shorts and upload UI; subtitle translation off during initial testing.
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{"captionLang":"off"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js

# Locket: preserve the pair from the module the user reports working.
# Upstream script also modifies other RevenueCat responses; do not stack RevenueCat modules.
locket.response = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/vuong2023/shad/main/js/Locket_Ohoang7.js,requires-body=true,max-size=-1,timeout=60
locket.deleteHeader = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/vuong2023/shad/main/js/deleteHeader.js,timeout=60

# Spotify: original app2smile module, partial client-side features only.
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-proto.js,script-update-interval=0

# SoundCloud: source reachable; old script. Server-side Go+ catalog/offline rights not verified.
soundcloud.response = type=http-response,pattern=^https:\/\/api-mobile\.soundcloud\.com\/configuration\/ios(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Marol62926/MarScrpt/main/soundcloud.js

# PicsArt: this source requires RESPONSE, not the old REQUEST rule.
# Match the API documented inside NobyDa's script, not guessed gw-v2 endpoints.
picsart.response = type=http-response,pattern=^https:\/\/api\.(picsart|meiease)\.c(n|om)\/shop\/subscription\/(validate|apple\/purchases),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Surge/JS/PicsArt.js

# CamScanner: upstream documents only partial features.
camscanner.response = type=http-response,pattern=^https:\/\/(api|api-cs)\.intsig\.net\/purchase\/cs\/query_property\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Surge/JS/CamScanner.js

# Wink: limit to the user VIP-info endpoint; do not rewrite every Meitu response.
# wink.response = type=http-response,pattern=^https:\/\/api-sub\.meitu\.com\/v2\/user\/vip_info(?:_by_group)?\.json(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ekaznyra/NguyenNgocAnhTu/master/Module/js/Wink.js
wink.response = type=http-response,pattern=^https:\/\/api-.*\.meitu\.com\/(.+\/user\/vip_info|user\/show),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/mtxl.js

# Truecaller: exactly the two endpoint types handled by this source.
truecaller.response = type=http-response,pattern=^https:\/\/premium-[^.]+\.truecaller\.com\/v\d+\/(subscriptions\/status|products\/apple)(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ekaznyra/NguyenNgocAnhTu/master/Module/js/TrueCaller.js

# KineMaster: legacy assetstore API. Do not reuse api-account /user/subscribe.
kinemaster.response = type=http-response,pattern=^https:\/\/api-kinemaster-assetstore\.(nexstreaming|kinemasters)\.com\/.+\/product\/verifyReceipt$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NobyDa/Scripting/master/kinemaster.js

# BeautyPlus: only manual_unlock. The script's asset/balance branch is intentionally not matched.
beautyplus.response = type=http-response,pattern=^https:\/\/api\.mr\.pixocial\.com\/v1\/manual_unlock(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ekaznyra/NguyenNgocAnhTu/master/Module/js/BeautyPlus.js

# Lightroom: existing source; does not grant genuine Adobe cloud storage.
lightroom.response = type=http-response,pattern=^https:\/\/photos\.adobe\.io\/v2\/accounts(?:[/?].*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/litieyin/AD_VIP/main/Script/lightroom.js

# Alight Motion
alightmotion.response = type=http-response,pattern=^https:\/\/us-central1-alight-creative\.cloudfunctions\.net\/getAccountStatusAndLicenses,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/refs/heads/main/alight-motion.json

# Sandbox Pixel Art (original pattern had no anchor and api.sandbox.love was missing from MITM; both fixed)
sandboxpixelart.response = type=http-response,pattern=^https:\/\/api\.sandbox\.love\/accounts\/current,requires-body=true,max-size=131072,timeout=10,script-path=https://N9dev-dev.github.io/SL/scripts/SandBox.js

# Funimate
funimate.response = type=http-response,pattern=^https:\/\/api\.funimate\.com\/users\/me,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/main/Funimate.json

# djay
djay.response = type=http-response,pattern=^https:\/\/app\.algoriddim\.com\/api\/v1\/validate-receipt,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/main/djay.json

# Vizmato
vizmato.response = type=http-response,pattern=^https:\/\/web\.vizmato\.com\/itunesreceipt_v5\.php,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/main/vizmato.json

# Reface
reface.response = type=http-response,pattern=^https:\/\/api\.reface\.video\/api\/reface\/v1\/iosSubscription,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/main/reface.json

# Busuu (upstream file is spelled bussu.json)
busuu.response = type=http-response,pattern=^https:\/\/api\.busuu\.com\/users\/me,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/main/bussu.json

# Calm
calm.response = type=http-response,pattern=^https:\/\/api\.calm\.com\/me$,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/main/calm.json

# Unfold
unfold.response = type=http-response,pattern=^https:\/\/api\.unfold\.app\/v1\/ios\/receipts,requires-body=true,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/iSteal-it/script/main/unfoldtest.json

# Meitu
meituxiuxiu.response = type=http-response,pattern=^https?:\/\/(h5|api)\.xiuxiu\.meitu\.com\/.+\/(vip|user|h\d|center|home),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/mtxx.js
	
[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, www.googleapis.com, graph.nhaccuatui.com, api.revenuecat.com, spclient.wg.spotify.com, *spclient.spotify.com, api-mobile.soundcloud.com, api.picsart.com, api.picsart.cn, api.meiease.com, api.meiease.cn, api.intsig.net, api-cs.intsig.net, api-sub.meitu.com, premium*.truecaller.com, api-kinemaster-assetstore.nexstreaming.com, api-kinemaster-assetstore.kinemasters.com, api.mr.pixocial.com, photos.adobe.io, us-central1-alight-creative.cloudfunctions.net, api.sandbox.love, api.funimate.com, app.algoriddim.com, web.vizmato.com, api.reface.video, api.busuu.com, api.calm.com, api.unfold.app, h5.xiuxiu.meitu.com, api-*.meitu.com
